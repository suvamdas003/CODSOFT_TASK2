# ─────────────────────────────────────────────────────────────────────────────
# DineDesk environment configuration.
# Copy this file to `.env` and adjust. NEVER commit `.env`.
# All values below are placeholders / local-development defaults only.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string used by the app, Prisma CLI and seed script.
# Default matches docker-compose.yml (host port 5433). For a local PostgreSQL
# install, replace user/password/port with your own.
DATABASE_URL="postgresql://dinedesk:dinedesk_dev_password@localhost:5433/dinedesk?schema=public"

# Separate database used ONLY by the integration test suite (it is wiped by tests).
DATABASE_URL_TEST="postgresql://dinedesk:dinedesk_dev_password@localhost:5433/dinedesk_test?schema=public"

# Separate database used ONLY by the Playwright end-to-end tests (reset and re-seeded on every run).
DATABASE_URL_E2E="postgresql://dinedesk:dinedesk_dev_password@localhost:5433/dinedesk_e2e?schema=public"

# Better Auth. `npm run env:init` replaces this placeholder with a random secret
# (the app refuses to start in production with a placeholder or short secret).
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
# Optional comma-separated extra origins allowed to call auth endpoints.
TRUSTED_ORIGINS=""
# Login / sign-up rate limiting (Better Auth). Setting "false" only works outside
# production (local debugging); production always enforces rate limits.
AUTH_RATE_LIMIT_ENABLED="true"
# Optional comma-separated CIDRs of extra trusted proxies in front of the app
# (e.g. a load balancer). Leave empty unless you know you need it.
TRUSTED_PROXY_CIDRS=""

# Public base URL used to build payment return URLs.
APP_URL="http://localhost:3000"

# ── Online payments (optional) ───────────────────────────────────────────────
# Leave empty to disable online card payments; cash/manual payments still work.
# Use Stripe TEST-MODE keys only (sk_test_..., whsec_...). See docs/PAYMENTS.md.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Development seed accounts (local demo only)
# Set these locally when testing; never use production credentials here.
SEED_ADMIN_EMAIL="admin@dinedesk.test"
SEED_ADMIN_PASSWORD=""
SEED_KITCHEN_EMAIL="kitchen@dinedesk.test"
SEED_KITCHEN_PASSWORD=""
SEED_CUSTOMER_EMAIL="customer@dinedesk.test"
SEED_CUSTOMER_PASSWORD=""
