# ─────────────────────────────────────────────────────────────────────────────
# DineDesk production configuration for the Docker stack (docker-compose.yml).
#
# Create the real file with generated secrets:   npm run env:init:prod
# (or copy this file to .env.production and replace every placeholder).
# .env.production is git-ignored and is never copied into the image.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (container "db"; not published to the host).
POSTGRES_USER="dinedesk"
POSTGRES_DB="dinedesk"
POSTGRES_PASSWORD="replace-with-a-strong-database-password"
# Must use the same user/password/database as above; host "db" is the compose service.
DATABASE_URL="postgresql://dinedesk:replace-with-a-strong-database-password@db:5432/dinedesk?schema=public"

# Better Auth. BETTER_AUTH_URL must be exactly the URL people open in the
# browser (scheme + host + port). Use https:// for anything beyond localhost.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:8080"
APP_URL="http://localhost:8080"
TRUSTED_ORIGINS=""
# Extra trusted proxies (CIDRs) if you put a load balancer in front of the bundled nginx.
TRUSTED_PROXY_CIDRS=""

# Online payments (optional). Leave empty to offer pay-at-restaurant only.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
